[["Коя дроб е правилна?", ["7/5", "3/8", "9/9"], 1, "Числителят е по-малък от знаменателя."], ["Коя дроб е неправилна?", ["2/7", "5/6", "8/3"], 2, "Числителят е по-голям от знаменателя."], ["Сравни 4/9 с 1.", ["<", "=", ">"], 0, "Правилната дроб е по-малка от 1."], ["Сравни 11/7 с 1.", ["<", "=", ">"], 2, "11 е по-голямо от 7."], ["Колко е 6/6?", ["0", "1", "6"], 1, "Равни числител и знаменател дават 1."], ["Кое е реципрочното число на 3/5?", ["3/5", "5/3", "-3/5"], 1, "Разменяме местата на числителя и знаменателя."], ["Кое е реципрочното число на 7?", ["1/7", "7/1", "0"], 0, "7 = 7/1, следователно реципрочното е 1/7."], ["Коя двойка е от реципрочни числа?", ["2/3 и 3/2", "2/3 и 2/3", "1/4 и 1/2"], 0, "Произведението на реципрочни числа е 1."], ["Кое число няма реципрочно?", ["1", "0", "2"], 1, "Няма число, което умножено по 0 да даде 1."], ["Коя дроб е равна на 1?", ["8/9", "9/8", "8/8"], 2, "Числителят и знаменателят са равни."], ["Колко е произведението 4/7 · 7/4?", ["1", "11/11", "16/49"], 0, "Произведението на реципрочни числа е 1."], ["Кое е реципрочното число на 1/9?", ["9", "1/9", "0"], 0, "Реципрочното на 1/9 е 9/1 = 9."], ["Коя дроб е по-голяма от 1?", ["5/12", "12/5", "5/5"], 1, "Неправилна дроб с числител по-голям от знаменателя."], ["Дробта 10/10 е:", ["правилна", "неправилна", "не е дроб"], 1, "Когато числителят е равен на знаменателя, дробта е неправилна и равна на 1."], ["Реципрочното на 2/11 е:", ["11/2", "2/11", "-11/2"], 0, "Разменяме числителя и знаменателя."]]